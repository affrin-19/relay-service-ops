# Auto detect text files and perform LF normalization on checkin
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Denote all binary files that should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.db binary
*.sqlite binary
