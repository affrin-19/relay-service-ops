# ==============================================================================
# RELAY - AUTONOMOUS ENTERPRISE SERVICE OPERATIONS PLATFORM
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed:
#   copy .env.example .env (Windows) or cp .env.example .env (macOS/Linux)

APP_NAME="Relay - Autonomous Enterprise Service Operations Platform"
APP_ENV=development
DEBUG=True

# Database Configuration (Defaults to absolute SQLite path anchored to project root)
DATABASE_URL=sqlite:///usm.db

# Vector Storage Directory for ChromaDB
CHROMA_PERSIST_DIRECTORY=data/chroma_db

# OpenAI API Configuration (Optional: system operates offline with heuristic & token-hashing fallbacks)
OPENAI_API_KEY=sk-your-openai-api-key-here
LLM_MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL_NAME=text-embedding-3-small
USE_OPENAI_EMBEDDINGS=False

# Webhook Alert Integrations (Optional: simulated in console if left blank)
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
